  long      g_onlyUpWithdrawScannedMsc = 0;  // moc DEAL_TIME_MSC da xu ly, tranh tru lap giao dich rut tien sau khi EA khoi dong lai

//+------------------------------------------------------------------+
//| Lay ngay NFP (Non-Farm Payrolls) tu Lich kinh te (Economic       |
//| Calendar) co san cua MQL5, thay cho mang 总_391_da_5DFC_si300[]   |
//| ma hoa cung. Neu khong tim/lay duoc (vi du: khong kha dung trong |
//| Strategy Tester cua broker nay) thi GIU NGUYEN mang hardcode co  |
//| san de kiem thu nguoc (backtest) van chay binh thuong.           |
//+------------------------------------------------------------------+
 void BuildNFPDatesFromCalendar()
 {
  g_nfpCalendarBuiltDay = (datetime)(TimeCurrent() - TimeCurrent() % 86400) ;
  MqlCalendarEvent legacyTemp_events[];
  int       legacyTemp_evTotal = CalendarEventByCountry("US",legacyTemp_events) ;
  long      legacyTemp_nfpId = -1;
  int       legacyTemp_i;
  string    legacyTemp_code;
//----- -----
 if ( legacyTemp_evTotal <= 0 )   { g_nfpStatus = 2 ; return; } // Lich MQL5 khong doc duoc -> panel bao loi lay tin
 for (legacyTemp_i = 0 ; legacyTemp_i < legacyTemp_evTotal ; legacyTemp_i ++)
 {
   // MqlCalendarEvent.name tra ve theo NGON NGU CUA TERMINAL (tai lieu MQL5)
   // nen so sanh chuoi tieng Anh co the khong bao gio khop neu terminal dat
   // ngon ngu khac. event_code moi la ma dinh danh CO DINH, khong phu thuoc
   // ngon ngu (vi du "NONFARM-PAYROLLS") - dung field nay lam chinh, giu lai
   // kiem tra .name nhu du phong.
   legacyTemp_code = legacyTemp_events[legacyTemp_i].event_code ;
   StringToUpper(legacyTemp_code) ;
   if ( StringFind(legacyTemp_code,"NONFARM") >= 0 || StringFind(legacyTemp_events[legacyTemp_i].name,"Nonfarm Payrolls") >= 0 || StringFind(legacyTemp_events[legacyTemp_i].name,"Non-Farm Payrolls") >= 0 || StringFind(legacyTemp_events[legacyTemp_i].name,"Non Farm Payrolls") >= 0 )
   {
     legacyTemp_nfpId = (long)legacyTemp_events[legacyTemp_i].id ;
     break;
   }
 }
 if ( legacyTemp_nfpId < 0 )   { g_nfpStatus = 2 ; return; } // khong tim thay su kien NFP trong Lich -> loi lay tin
 MqlCalendarValue legacyTemp_values[];
 datetime  legacyTemp_from = D'2007.01.01 00:00';
 datetime  legacyTemp_to = TimeCurrent() + 400 * 24 * 60 * 60 ;
 int       legacyTemp_n = CalendarValueHistoryByEvent((ulong)legacyTemp_nfpId,legacyTemp_values,legacyTemp_from,legacyTemp_to) ;
 if ( legacyTemp_n <= 0 )   { g_nfpStatus = 2 ; return; } // khong lay duoc gia tri lich NFP -> loi lay tin
 // 总_390_da_5DC0 (GMT hien tai) da duoc tinh xong truoc khi ham nay duoc goi (xem
 // OnTick). MqlCalendarValue.time tra ve theo GIO SERVER, trong khi
 // 总_391_da_5DFC_si300[] va toan bo bo loc NFP con lai dang quy uoc luu GIO GMT roi
 // moi cong offset de quy doi sang gio server luc so sanh/hien thi. TimeCurrent()-
 // 总_390_da_5DC0 chinh la offset GMT bo loc dang dung tai thoi diem nay (du la tu
 // AutoGMT/WebRequest thanh cong hay phai roi ve TimeGMT()), nen dung gia tri nay de
 // tru truoc khi luu, tranh bi quy doi 2 lan.
 long      legacyTemp_offsetSeconds = (long)(TimeCurrent() - legacyGlobalDatetime390) ;
 int       legacyTemp_count = 0;
 for (legacyTemp_i = 0 ; legacyTemp_i < legacyTemp_n && legacyTemp_count < 300 ; legacyTemp_i ++)
 {
   if ( legacyTemp_values[legacyTemp_i].time <= 0 )   continue;
   nfpDatesGmt[legacyTemp_count] = (datetime)(legacyTemp_values[legacyTemp_i].time - legacyTemp_offsetSeconds) ;
   legacyTemp_count ++;
 }
 if ( legacyTemp_count <= 0 )   { g_nfpStatus = 0 ; return; } // lay tin OK nhung khong co ngay hop le -> "No News Coming Up"
 for (legacyTemp_i = legacyTemp_count ; legacyTemp_i < 300 ; legacyTemp_i ++)   nfpDatesGmt[legacyTemp_i] = 0 ;
 g_nfpFromCalendar = true ;
 g_nfpStatus = 0 ; // lay Lich thanh cong -> panel hien binh thuong (Next NFP / No News)
 }
//BuildNFPDatesFromCalendar <<==--------   --------

//+------------------------------------------------------------------+
//| Dieu chinh dinh OnlyUp khi tai khoan co giao dich rut tien.       |
//| Trong MT5, nap/rut tien duoc ghi thanh DEAL_TYPE_BALANCE; rut     |
//| tien co DEAL_PROFIT am. Dinh cu phai giam dung bang so tien rut,  |
//| nhung khong duoc thap hon balance/equity hien tai.                |
//+------------------------------------------------------------------+
 void ApplyOnlyUpWithdrawal(double amount)
 {
  if ( !(OnlyUp) || ManualBalance>0.0 || amount>=0.0 )   return;
  highestBalanceBasis = highestBalanceBasis + amount ; // amount am => tru tien rut khoi dinh
  double legacyTemp_current = AccountInfoDouble(ACCOUNT_BALANCE) ;
  if ( UseEquity )   legacyTemp_current = AccountInfoDouble(ACCOUNT_EQUITY) ;
  if ( highestBalanceBasis<legacyTemp_current )   highestBalanceBasis = legacyTemp_current ;
  if ( highestBalanceBasis<0.0 )   highestBalanceBasis = 0.0 ;
  GlobalVariableSet(OnlyUpPeakGVName(),highestBalanceBasis) ;
 }
//ApplyOnlyUpWithdrawal <<==--------   --------

//+------------------------------------------------------------------+
//| Doc cac giao dich rut tien bi bo lo khi EA/MT5 khong chay.        |
//| Moc quet luu theo mili-giay vi GlobalVariable kieu double van luu |
//| chinh xac DEAL_TIME_MSC (~10^12), dong thoi tranh xu ly lap.      |
//+------------------------------------------------------------------+
 void ReconcileOnlyUpWithdrawals()
 {
  if ( !(OnlyUp) || ManualBalance>0.0 )   return;
  long legacyTemp_nowMsc = (long)TimeCurrent() * 1000 ;
  if ( g_onlyUpWithdrawScannedMsc<=0 )
  {
    g_onlyUpWithdrawScannedMsc = legacyTemp_nowMsc ;
    GlobalVariableSet(OnlyUpWithdrawGVName(),(double)g_onlyUpWithdrawScannedMsc) ;
    return;
  }
  datetime legacyTemp_from = (datetime)(g_onlyUpWithdrawScannedMsc / 1000) ;
  datetime legacyTemp_to = TimeCurrent() ;
  if ( legacyTemp_from>legacyTemp_to )   legacyTemp_from = legacyTemp_to ;
  if ( !(HistorySelect(legacyTemp_from,legacyTemp_to)) )   return;
  int legacyTemp_total = HistoryDealsTotal() ;
  double legacyTemp_withdrawals = 0.0 ;
  long legacyTemp_latestMsc = g_onlyUpWithdrawScannedMsc ;
  for (int legacyTemp_i = 0 ; legacyTemp_i < legacyTemp_total ; legacyTemp_i ++)
  {
    ulong legacyTemp_ticket = HistoryDealGetTicket(legacyTemp_i) ;
    if ( legacyTemp_ticket==0 )   continue;
    long legacyTemp_dealMsc = (long)HistoryDealGetInteger(legacyTemp_ticket,DEAL_TIME_MSC) ;
    if ( legacyTemp_dealMsc<=g_onlyUpWithdrawScannedMsc )   continue;
